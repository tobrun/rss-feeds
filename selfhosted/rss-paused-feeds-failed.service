# systemd user service: triggered by OnFailure= of rss-paused-feeds.service. Sends a
# Telegram message when the unit itself failed (timeout or crash); the script reports its
# own failures.

[Unit]
Description=rss-feeds: notify that the paused-feed refresh unit failed

[Service]
Type=oneshot
ExecStart=/bin/bash -c '"$HOME/.claude/skills/send-telegram-message/scripts/send_telegram.sh" "rss-paused-feeds unit failed (timeout or crash); see journalctl --user -u rss-paused-feeds.service"'
